{
  "name": "simplerest/simplerest",
  "description": "The skeleton application for the Simple REST Framework",
  "keywords": [
    "REST",
    "framework"
  ],
  "type": "project",
  "license": "MIT",
  "homepage": "https://simplerest.ru",
  "support": {
    "issues": "https://github.com/simplerest/simplerest/issues",
    "source": "https://github.com/simplerest/simplerest"
  },
  "authors": [
    {
      "name": "Dmitriy Veremeenko",
      "email": "stdimensiy@yandex.ru"
    }
  ],
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "simplerest/framework",
        "version": "dev-develop",
        "source": {
          "url": "https://github.com/simplerest/framework",
          "type": "git",
          "reference": "origin/develop"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.1",
    "simplerest/framework": "dev-develop"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.6"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "composer install --no-autoloader --working-dir production/public/"
    ],
    "post-create-project-cmd": [
      "composer install --no-autoloader --working-dir production/public/"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
